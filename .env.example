# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# PostgreSQL connection string (defaults to embedded PGlite WASM if not provided)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auction_platform"

# Redis connection string (defaults to in-memory Redis-compliant Pub/Sub broker if not provided)
REDIS_URL="redis://localhost:6379"

# JWT Secret for authentication tokens
JWT_SECRET="auction_super_secret_jwt_key_hackathon_grade_2025"

# Google OAuth Credentials (optional, simulated flow available)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay Test Mode Credentials (fallback demo simulation also available)
RAZORPAY_KEY_ID="rzp_test_hackathon_demo"
RAZORPAY_KEY_SECRET="rzp_test_secret_hackathon"

# Email SMTP Settings
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT="2525"
EMAIL_USER=""
EMAIL_PASSWORD=""
